# EmailJS credentials for the contact form (https://dashboard.emailjs.com)
# Copy this file to `.env` and fill in your own values, then restart `npm run dev`.
# If these are left empty, the contact form falls back to opening the visitor's
# email app with the message pre-filled (mailto), so it still works.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
